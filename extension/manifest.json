{
  "manifest_version": 2,
  "name": "StudySift",
  "version": "1.0",
  "description": "Should I watch this? AI-powered video analyzer.",
  "permissions": [
    "activeTab",
    "tabs",
    "http://localhost:8000/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "StudySift",
    "default_icon": {
      "48": "icon.png"
    }
  }
}